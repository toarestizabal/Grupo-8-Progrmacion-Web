# Copia este archivo como .env y reemplaza los valores.
DJANGO_SECRET_KEY=reemplazar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_PRODUCTION=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_HSTS_SECONDS=3600
API_TOKEN_TTL_HOURS=24

# Oracle 19c: el esquema se crea con database/create_user.sql
ORACLE_DSN=localhost:1521/orclpdb
ORACLE_USER=PIXELFORGE_APP
ORACLE_PASSWORD=reemplazar_contrasena

# Esquema aislado creado con database/create_test_user.sql
ORACLE_TEST_USER=PIXELFORGE_TEST
ORACLE_TEST_PASSWORD=reemplazar_contrasena_pruebas
